# Arquivo do banco SQLite (padrão: data/emr.db)
DATABASE_FILE=data/emr.db

# Primeiro administrador, criado com `npm run db:seed`.
# A senha é provisória: deve ser forte e será trocada no primeiro acesso.
EMR_ADMIN_USERNAME=admin
EMR_ADMIN_NAME=Administrador do Sistema
# Use aspas se a senha tiver # (ex.: EMR_ADMIN_PASSWORD="Minha#Senha2026")
EMR_ADMIN_PASSWORD=

# Chaves de criptografia em repouso do prontuário (AES-256-GCM), no formato versao:chave_base64_32_bytes.
# Rotação: acrescente uma nova versão (ex.: 1:...,2:...); a mais alta cifra os novos registros e as
# anteriores continuam decifrando. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PERDER A CHAVE = PERDER O PRONTUÁRIO. Guarde uma cópia em cofre de senhas, fora do servidor.
EMR_CLINICAL_KEYS=

# Identificação do consultório impressa nas receitas (endereço é obrigatório para emitir).
CLINIC_NAME=
CLINIC_ADDRESS=
CLINIC_PHONE=
