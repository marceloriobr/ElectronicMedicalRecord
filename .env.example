# Arquivo do banco SQLite (padrão: data/emr.db)
DATABASE_FILE=data/emr.db

# Primeiro administrador, criado com `npm run db:seed`.
# A senha é provisória: deve ser forte e será trocada no primeiro acesso.
EMR_ADMIN_USERNAME=admin
EMR_ADMIN_NAME=Administrador do Sistema
# Obrigatório: o código da verificação em duas etapas do login é enviado para este endereço.
EMR_ADMIN_EMAIL=
# Use aspas se a senha tiver # (ex.: EMR_ADMIN_PASSWORD="Minha#Senha2026")
EMR_ADMIN_PASSWORD=

# Chaves de criptografia em repouso do prontuário (AES-256-GCM), no formato versao:chave_base64_32_bytes.
# Rotação: acrescente uma nova versão (ex.: 1:...,2:...); a mais alta cifra os novos registros e as
# anteriores continuam decifrando. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PERDER A CHAVE = PERDER O PRONTUÁRIO. Guarde uma cópia em cofre de senhas, fora do servidor.
EMR_CLINICAL_KEYS=

# Identificação do consultório impressa nas receitas (endereço é obrigatório para emitir).
CLINIC_NAME=
CLINIC_ADDRESS=
CLINIC_PHONE=

# --- Verificação em duas etapas (código por e-mail a cada login) ---
# smtp    = envia de verdade (obrigatório em produção).
# arquivo = SOMENTE desenvolvimento/testes: grava o e-mail em data/outbox/ (veja com `npm run mail:ultimo`).
#           Recusado em produção. É o padrão quando NODE_ENV não é "production".
EMAIL_TRANSPORT=
SMTP_HOST=
# 587 (STARTTLS) ou 465 (TLS). O envio sem criptografia é recusado.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente (ex.: "Prontuário <nao-responda@seudominio.com.br>"). Configure SPF/DKIM/DMARC no domínio.
EMAIL_FROM=

# --- Backup criptografado (npm run db:backup) ---
# Chave AES-256 em base64 (32 bytes), diferente da EMR_CLINICAL_KEYS. Guarde em cofre de senhas, fora do servidor:
# sem ela o backup não abre. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMR_BACKUP_KEY=

# --- Proxy reverso ---
# Quantos proxies CONFIÁVEIS existem na frente do app (padrão 1). O IP gravado na auditoria e usado no limite de
# tentativas de login é o N-ésimo a partir do fim do X-Forwarded-For. Use 0 se o app for exposto direto
# (o cabeçalho é ignorado e o IP não é registrado).
TRUSTED_PROXY_HOPS=1
