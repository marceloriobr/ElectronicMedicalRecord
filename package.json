{
  "name": "electronic-medical-record",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-admin.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "bash tests/e2e/run.sh",
    "db:reset-admin": "tsx --env-file-if-exists=.env.local scripts/reset-admin-password.ts",
    "db:seed-pacientes": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-patients.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
